#!/bin/bash

set -e
cd *

mkdir build
cd build

../configure
	--prefix=/usr            \
	--enable-languages=c,c++ \
	--enable-default-pie     \
	--enable-default-ssp     \
	--enable-host-pie        \
	--disable-multilib       \
	--disable-bootstrap      \
	--disable-fixincludes    \
	--with-system-zlib
make -j${JOBS}
make DESTDIR=$INSTALL_PATH install
ln -s gcc $INSTALL_PATH/usr/bin/cc
